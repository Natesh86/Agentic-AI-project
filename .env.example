# =====================================================================
# SoloBiz AI - Environment Configuration
# Copy this file to .env and configure your keys
# =====================================================================

# 1. Anthropic API Key (Required for live Claude calls)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection (Defaults to 3.5 Haiku and 3.5 Sonnet)
SOLOBIZ_MODEL_FAST=claude-3-5-haiku-20241022
SOLOBIZ_MODEL_REASONING=claude-3-5-sonnet-20241022
ENABLE_PROMPT_CACHING=true

# 2. Langfuse Observability (Sign up free at https://cloud.langfuse.com)
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key-here"
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key-here"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# 3. Operational Thresholds
MAX_AUTONOMOUS_ORDER_VALUE=5000.0
SENTIMENT_CRITICAL_THRESHOLD=0.35
MIN_CONFIDENCE_THRESHOLD=0.85
